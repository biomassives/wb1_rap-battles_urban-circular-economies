function openModal(type, subtype) {
  const modal = document.getElementById('modal-overlay');
  const title = document.getElementById('modal-title');
  const body = document.getElementById('modal-body');

  modal.style.display = 'flex';

  // Set content based on type
  switch (type) {
    case 'new-project':
      title.textContent = 'Create New Project';
      body.innerHTML = `
        <form id="new-project-form" onsubmit="submitNewProject(event)" class="modal-form">
          <label>Title *</label>
          <input type="text" name="title" required minlength="3" placeholder="Project title..." />
          <label>Description</label>
          <textarea name="description" rows="3" placeholder="What's this project about?"></textarea>
          <label>Category</label>
          <select name="category">
            <option value="general">General</option>
            <option value="music">Music</option>
            <option value="art">Art</option>
            <option value="community">Community</option>
            <option value="tech">Technology</option>
            <option value="environment">Environment</option>
            <option value="health">Health</option>
            <option value="education">Education</option>
          </select>
          <label>Visibility</label>
          <select name="visibility">
            <option value="public">Public</option>
            <option value="private">Private</option>
          </select>
          <label>Status</label>
          <select name="status">
            <option value="draft">Draft</option>
            <option value="published">Published</option>
          </select>
          <button type="submit" class="primary-btn" style="margin-top:1rem;width:100%;">Create Project</button>
        </form>`;
      break;
    case 'edit-project':
      title.textContent = 'Edit Project';
      body.innerHTML = '<div class="loading">Loading...</div>';
      loadEditProject(subtype);
      break;
    case 'project-notes':
      title.textContent = 'Project Notes';
      body.innerHTML = '<div class="loading">Loading notes...</div>';
      loadProjectNotes(subtype);
      break;
    case 'invite-member':
      title.textContent = 'Invite Member';
      body.innerHTML = `
        <form id="invite-form" onsubmit="submitInvite(event)" class="modal-form" data-project-id="${subtype}">
          <label>Email Address *</label>
          <input type="email" name="email" required placeholder="collaborator@example.com" />
          <label>Role</label>
          <select name="role">
            <option value="member">Member</option>
            <option value="editor">Editor</option>
            <option value="admin">Admin</option>
          </select>
          <label>Personal Message (optional)</label>
          <textarea name="message" rows="2" placeholder="Hey, join my project!"></textarea>
          <button type="submit" class="primary-btn" style="margin-top:1rem;width:100%;">Send Invite</button>
          <div id="invite-result" style="margin-top:0.75rem;"></div>
        </form>`;
      break;
    case 'project-members':
      title.textContent = 'Project Members';
      body.innerHTML = '<div class="loading">Loading members...</div>';
      loadProjectMembers(subtype);
      break;
    case 'submit-data':
      title.textContent = 'Submit Data';
      body.innerHTML = `<p>Data submission form coming soon...</p>`;
      break;
    case 'payout':
      title.textContent = 'Cash Out';
      body.innerHTML = `<p>Payout form for ${subtype} coming soon...</p>`;
      break;
    default:
      title.textContent = 'Modal';
      body.innerHTML = '';
  }
}

