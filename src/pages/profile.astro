async function submitNewProject(e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.textContent = 'Creating...';

  try {
    const res = await fetch('/api/projects/create', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        walletAddress: profileManager.wallet,
        title: form.title.value,
        description: form.description.value,
        category: form.category.value,
        visibility: form.visibility.value,
        status: form.status.value,
      }),
    });
    const data = await res.json();
    if (data.success) {
      closeModal();
      profileManager.loadWorkData();
    } else {
      alert(data.error || 'Failed to create project');
      btn.disabled = false;
      btn.textContent = 'Create Project';
    }
  } catch (err) {
    alert('Error: ' + err.message);
    btn.disabled = false;
    btn.textContent = 'Create Project';
  }
}

async function loadEditProject(projectId) {
  const body = document.getElementById('modal-body');
  try {
    const p = profileManager.projects.find(proj => proj.id === projectId);
    if (!p) { body.innerHTML = `<p class="empty-state">Project not found</p>`; return; }
    body.innerHTML = `
      <form id="edit-project-form" onsubmit="submitEditProject(event, ${p.id})" class="modal-form">
        <label>Title *</label>
        <input type="text" name="title" required minlength="3" value="${profileManager.escapeHtml(p.title)}" />
        <label>Description</label>
        <textarea name="description" rows="3">${profileManager.escapeHtml(p.description || '')}</textarea>
        <label>Category</label>
        <select name="category">
          ${['general','music','art','community','tech','environment','health','education'].map(c =>
            `<option value="${c}" ${p.category === c ? 'selected' : ''}>${c}</option>`
          ).join('')}
        </select>
        <label>Visibility</label>
        <select name="visibility">
          <option value="public" ${p.visibility === 'public' ? 'selected' : ''}>Public</option>
          <option value="private" ${p.visibility === 'private' ? 'selected' : ''}>Private</option>
        </select>
        <label>Status</label>
        <select name="status">
          <option value="draft" ${p.status === 'draft' ? 'selected' : ''}>Draft</option>
          <option value="published" ${p.status === 'published' ? 'selected' : ''}>Published</option>
          <option value="archived" ${p.status === 'archived' ? 'selected' : ''}>Archived</option>
        </select>
        <button type="submit" class="primary-btn" style="margin-top:1rem;width:100%;">Save Changes</button>
      </form>`;
  } catch (err) {
    body.innerHTML = `<p class="empty-state">Failed to load project</p>`;
  }
}

async function submitEditProject(e, projectId) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type="submit"]');
  btn.disabled = true;
  btn.textContent = 'Saving...';

  try {
    const res = await fetch('/api/projects/update', {
      method: 'PUT',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        walletAddress: profileManager.wallet,
        projectId,
        title: form.title.value,
        description: form.description.value,
        category: form.category.value,
        visibility: form.visibility.value,
        status: form.status.value,
      }),
    });
    const data = await res.json();
    if (data.success) {
      closeModal();
      profileManager.loadWorkData();
    } else {
      alert(data.error || 'Failed to update');
      btn.disabled = false;
      btn.textContent = 'Save Changes';
    }
  } catch (err) {
    alert('Error: ' + err.message);
    btn.disabled = false;
    btn.textContent = 'Save Changes';
  }
}

async function loadProjectNotes(projectId) {
  const body = document.getElementById('modal-body');
  try {
    const res = await fetch(`/api/projects/notes/list?projectId=${projectId}&walletAddress=${profileManager.wallet}`);
    const data = await res.json();
    let html = `
      <form id="add-note-form" onsubmit="submitNote(event, ${projectId})" class="modal-form" style="margin-bottom:1rem;">
        <textarea name="content" rows="2" required placeholder="Add a note..."></textarea>
        <div style="display:flex;gap:0.5rem;align-items:center;margin-top:0.5rem;">
          <select name="noteType" style="flex:1;">
            <option value="general">General</option>
            <option value="todo">To-Do</option>
            <option value="idea">Idea</option>
            <option value="update">Update</option>
          </select>
          <button type="submit" class="primary-btn" style="flex:1;">Add Note</button>
        </div>
      </form>
      <div class="notes-list">`;
    if (data.success && data.notes.length > 0) {
      html += data.notes.map(n => `
        <div class="note-item">
          <div class="note-header">
            <span class="note-author">${profileManager.escapeHtml(n.author_name)}</span>
            <span class="note-type-badge">${n.note_type}</span>
            <span class="note-date">${new Date(n.created_at).toLocaleDateString()}</span>
          </div>
          <p class="note-content">${profileManager.escapeHtml(n.content)}</p>
        </div>
      `).join('');
    } else {
      html += '<div class="empty-state">No notes yet</div>';
    }
    html += '</div>';
    body.innerHTML = html;
  } catch (err) {
    body.innerHTML = `<p class="empty-state">Failed to load notes</p>`;
  }
}

async function submitNote(e, projectId) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type="submit"]');
  btn.disabled = true;

  try {
    const res = await fetch('/api/projects/notes/add', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        walletAddress: profileManager.wallet,
        projectId,
        content: form.content.value,
        noteType: form.noteType.value,
      }),
    });
    const data = await res.json();
    if (data.success) {
      loadProjectNotes(projectId);
    } else {
      alert(data.error || 'Failed to add note');
      btn.disabled = false;
    }
  } catch (err) {
    alert('Error: ' + err.message);
    btn.disabled = false;
  }
}

async function submitInvite(e) {
  e.preventDefault();
  const form = e.target;
  const btn = form.querySelector('button[type="submit"]');
  const resultEl = document.getElementById('invite-result');
  btn.disabled = true;
  btn.textContent = 'Sending...';

  try {
    const res = await fetch('/api/projects/invite', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        walletAddress: profileManager.wallet,
        projectId: parseInt(form.dataset.projectId),
        email: form.email.value,
        role: form.role.value,
        message: form.message.value,
      }),
    });
    const data = await res.json();
    if (data.success) {
      resultEl.innerHTML = `
        <div style="background:#0a0a0f;border:1px solid #2a2a3a;border-radius:8px;padding:12px;">
          <p style="color:#10b981;margin:0 0 4px;font-weight:600;">Invite sent!</p>
          <p style="color:#888;margin:0;font-size:0.8rem;">Email ${data.emailSent ? 'delivered' : 'queued'} via ${data.emailProvider || 'queue'}</p>
          <p style="color:#666;margin:4px 0 0;font-size:0.75rem;word-break:break-all;">Link: ${data.inviteUrl}</p>
        </div>`;
      form.email.value = '';
      form.message.value = '';
      btn.textContent = 'Send Another';
      btn.disabled = false;
    } else {
      resultEl.innerHTML = `<p style="color:#ef4444;">${data.error}</p>`;
      btn.disabled = false;
      btn.textContent = 'Send Invite';
    }
  } catch (err) {
    resultEl.innerHTML = `<p style="color:#ef4444;">Error: ${err.message}</p>`;
    btn.disabled = false;
    btn.textContent = 'Send Invite';
  }
}

async function loadProjectMembers(projectId) {
  const body = document.getElementById('modal-body');
  try {
    const res = await fetch(`/api/projects/members?projectId=${projectId}&walletAddress=${profileManager.wallet}`);
    const data = await res.json();
    if (!data.success) { body.innerHTML = `<p class="empty-state">${data.error}</p>`; return; }

    let html = '<div class="members-list">';
    if (data.members.length > 0) {
      html += data.members.map(m => {
        const statusClass = m.invite_status === 'accepted' ? 'member-accepted' : 'member-pending';
        return `
        <div class="member-item">
          <div class="member-info">
            <span class="member-name">${profileManager.escapeHtml(m.username)}</span>
            <span class="member-role">${m.role}</span>
          </div>
          <div class="member-right">
            <span class="member-status ${statusClass}">${m.invite_status}</span>
            ${m.email ? `<span class="member-email">${profileManager.escapeHtml(m.email)}</span>` : ''}
          </div>
        </div>`;
      }).join('');
    } else {
      html += '<div class="empty-state">No members yet. Invite someone!</div>';
    }
    html += '</div>';
    body.innerHTML = html;
  } catch (err) {
    body.innerHTML = `<p class="empty-state">Failed to load members</p>`;
  }
}

async function deleteProject(projectId) {
  if (!confirm('Are you sure you want to delete this project? This cannot be undone.')) return;
  try {
    const res = await fetch('/api/projects/delete', {
      method: 'DELETE',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({ walletAddress: profileManager.wallet, projectId }),
    });
    const data = await res.json();
    if (data.success) {
      profileManager.loadWorkData();
    } else {
      alert(data.error || 'Failed to delete project');
    }
  } catch (err) {
    alert('Error: ' + err.message);
  }
}

// Initialize
const profileManager = new ProfileManager();
document.addEventListener('DOMContentLoaded', () => profileManager.init());
</script>
