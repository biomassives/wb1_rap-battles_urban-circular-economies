    }
  }

  async savePayoutSettings() {
    const form = document.getElementById('payout-settings-form');
    const formData = new FormData(form);

    try {
      await fetch('/api/payout/settings', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          walletAddress: this.wallet,
          preferredMethod: formData.get('preferred_method'),
          mobileMoneyProvider: formData.get('mobile_provider'),
          mobileMoneyPhone: formData.get('mobile_phone'),
          cryptoWalletAddress: formData.get('crypto_wallet')
        })
      });
      alert('Payout settings saved!');
    } catch (e) {
      alert('Failed to save settings');
    }
  }

  filterNotifications(filter) {
    // Filter notification list
    const items = document.querySelectorAll('.notification-item');
    items.forEach(item => {
      if (filter === 'all') {
        item.style.display = 'flex';
      } else {
        const notif = this.notifications.find(n => n.id == item.dataset.id);
        item.style.display = notif?.category === filter ? 'flex' : 'none';
      }
    });
  }

  async claimReward(ruleId) {
    try {
      const res = await fetch('/api/nft/rewards/claim', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ walletAddress: this.wallet, ruleId })
      });
      const data = await res.json();
      if (data.success) {
        alert(data.message);
        this.loadRewardsData();
      } else {
        alert(data.error);
      }
    } catch (e) {
      alert('Failed to claim reward');
    }
  }

  // ── Danger Zone ──────────────────────────────────────────

  async loadDangerZone() {
    this.dangerLoaded = true;
    const container = document.getElementById('danger-projects-list');
    if (!container || !this.wallet) return;

    try {
      const res = await fetch(`/api/projects/user?walletAddress=${this.wallet}`);
      const data = await res.json();

      if (data.success && data.projects && data.projects.length > 0) {
        this.dangerProjects = data.projects;
        container.innerHTML = data.projects.map(p => `
          <div class="danger-project-row" data-project-id="${p.id}">
            <div>
              <div class="danger-project-title">${this.escapeHtml(p.title)}</div>
              <div class="danger-project-meta">${p.category || 'general'} &middot; ${p.status || 'draft'}</div>
            </div>
            <select class="danger-project-action" data-pid="${p.id}" onchange="profileManager.onProjectActionChange(${p.id}, this.value)">
              <option value="delete">Delete</option>
              <option value="claimable">Make Claimable</option>
              <option value="transfer">Transfer</option>
            </select>
            <input type="text" class="danger-transfer-input" id="transfer-wallet-${p.id}"
              placeholder="Target wallet address" style="display:none;">
          </div>
        `).join('');
      } else {
        container.innerHTML = '<p class="text-muted">No projects to manage.</p>';
      }
    } catch (e) {
      container.innerHTML = '<p class="text-muted">Could not load projects.</p>';
    }
  }

  onProjectActionChange(projectId, action) {
    const input = document.getElementById('transfer-wallet-' + projectId);
    if (input) {
      input.style.display = action === 'transfer' ? 'block' : 'none';
    }
  }

  async deleteAccount() {
    if (!this.wallet) return;

    const confirmInput = document.getElementById('delete-confirm-input');
    if (!confirmInput || confirmInput.value !== 'DELETE') return;

    // Gather project actions
    const projectActions = {};
    document.querySelectorAll('.danger-project-action').forEach(select => {
      const pid = select.dataset.pid;
      const action = select.value;
      const entry = { action };
      if (action === 'transfer') {
        const walletInput = document.getElementById('transfer-wallet-' + pid);
        entry.targetWallet = walletInput?.value || '';
        if (!entry.targetWallet) {
          alert('Please enter a target wallet for project transfer (ID: ' + pid + ')');
          return;
        }
      }
      projectActions[pid] = entry;
    });

    // Final confirmation
    const finalConfirm = confirm(
      'FINAL WARNING: This will permanently delete your account and all associated data. ' +
      'This cannot be undone. Are you sure?'
    );
    if (!finalConfirm) return;

    const btn = document.getElementById('btn-delete-account');
    btn.disabled = true;
    btn.textContent = 'Deleting...';

    try {
      const res = await fetch('/api/account/delete', {
        method: 'DELETE',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          walletAddress: this.wallet,
          confirmation: 'DELETE',
          projectActions
        })
      });
      const data = await res.json();

      if (data.success) {
        // Clear local storage and redirect
        localStorage.removeItem('connectedWallet');
        localStorage.removeItem('anonymousWallet');
        localStorage.removeItem('wb_username');
        localStorage.removeItem('wb_xp');
        localStorage.removeItem('wb_level');
        alert('Your account has been deleted. You will be redirected to the homepage.');
        window.location.href = '/';
      } else {
        alert('Error: ' + (data.error || 'Failed to delete account'));
        btn.disabled = false;
        btn.textContent = 'Delete My Account';
      }
    } catch (e) {
      alert('Network error: ' + e.message);
      btn.disabled = false;
      btn.textContent = 'Delete My Account';
    }
  }

  escapeHtml(str) {
    if (!str) return '';
    return str.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
  }
}

