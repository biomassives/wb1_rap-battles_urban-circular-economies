---
import BaseLayout from '../../layouts/BaseLayout.astro';
export const prerender = false;
---

<BaseLayout title="Elixir Lab - Transform Your Rapper PFPs" description="Earn mystical elixirs to upgrade your Rapper PFP cards. Each elixir boosts rarity and transforms visuals." activeSection="gallery">

  <!-- ============================================ -->
  <!-- SECTION 1: HERO HEADER -->
  <!-- ============================================ -->
  <section class="elixir-hero retro-ascii-section scanlines arcade-grid">
    <div class="container mx-auto">
      <div class="ascii-header-box">
        <pre class="ascii-border-top">
&#x2554;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2557;</pre>
        <div class="section-header-retro">
          <h1 class="section-title-glitch" data-text="ELIXIR LAB">
            <span class="glitch-layer">ELIXIR LAB</span>
            <span class="glitch-layer">ELIXIR LAB</span>
            <span class="glitch-layer">ELIXIR LAB</span>
          </h1>
          <div class="ascii-divider">
            <pre>&#x251C;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2500;&#x2524;</pre>
          </div>
          <p class="section-subtitle-retro">
            <span class="ascii-bracket">[ </span>
            <span class="neon-text">TRANSFORM YOUR RAPPER PFP CARDS</span>
            <span class="ascii-bracket"> ]</span><br/>
            <span class="ascii-bracket">[ </span>
            <span class="neon-text">UPGRADE RARITY + UNLOCK NEW VISUALS</span>
            <span class="ascii-bracket"> ]</span>
          </p>
        </div>
        <pre class="ascii-border-bottom">
&#x255A;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x2550;&#x255D;</pre>
      </div>

      <div class="hero-terminal mono">
        <p>> ELIXIRS ARE MYSTICAL REAGENTS THAT TRANSMUTE YOUR RAPPER PFP NFTs</p>
        <p>> EACH ELIXIR UPGRADES BOTH RARITY TIER AND VISUAL APPEARANCE</p>
        <p>> EARN THEM THROUGH XP MILESTONES, BATTLE WINS, AND CHALLENGES</p>
        <p class="text-cyan"><span class="blink">_</span></p>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION 2: ELIXIR CATALOG -->
  <!-- ============================================ -->
  <section class="elixir-catalog-section">
    <div class="container mx-auto">
      <h2 class="section-title mono neon-text">[ ELIXIR CATALOG ]</h2>
      <p class="section-subtitle mono text-muted">8 elixir types — 5 transmutation + 3 education tiers</p>

      <div class="elixir-grid">
        <!-- Rarity Elixir -->
        <a href="/elixir/rarity" class="elixir-link">
        <article class="elixir-card card-retro-neon" style="--elixir-color: #c850ff;">
          <div class="elixir-bottle-wrap">
            <div class="bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge common-badge">COMMON</span>
            <h3 class="elixir-name mono">RARITY ELIXIR</h3>
            <p class="elixir-desc">The fundamental transmutation reagent. Upgrades your Rapper PFP card by one rarity tier.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">+1 Rarity Tier</span></div>
              <div class="elixir-stat"><span class="stat-key">Visual:</span> <span class="stat-val">Enhanced border glow</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">40%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+0.25x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Chrono Elixir -->
        <a href="/elixir/chrono" class="elixir-link">
        <article class="elixir-card card-retro-neon" style="--elixir-color: #00e5ff;">
          <div class="elixir-bottle-wrap">
            <div class="bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge uncommon-badge">UNCOMMON</span>
            <h3 class="elixir-name mono">CHRONO ELIXIR</h3>
            <p class="elixir-desc">Distilled from temporal fragments. Upgrades rarity and adds a time-warp shimmer to your card.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">+1 Tier + Shimmer</span></div>
              <div class="elixir-stat"><span class="stat-key">Visual:</span> <span class="stat-val">Time-distortion overlay</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">25%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+0.25x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Phoenix Elixir -->
        <a href="/elixir/phoenix" class="elixir-link">
        <article class="elixir-card card-retro-neon" style="--elixir-color: #ff4500;">
          <div class="elixir-bottle-wrap">
            <div class="bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge rare-badge">RARE</span>
            <h3 class="elixir-name mono">PHOENIX ELIXIR</h3>
            <p class="elixir-desc">Born from ashes of defeated rivals. Upgrades rarity, adds flame effects, and resets your loss record.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">+1 Tier + Loss Reset</span></div>
              <div class="elixir-stat"><span class="stat-key">Visual:</span> <span class="stat-val">Flame particle border</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">15%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+0.50x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Prismatic Elixir -->
        <a href="/elixir/prismatic" class="elixir-link">
        <article class="elixir-card card-retro-neon prismatic-card" style="--elixir-color: #a855f7;">
          <div class="elixir-bottle-wrap">
            <div class="bottle prismatic-bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid prismatic-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow prismatic-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge legendary-badge">LEGENDARY</span>
            <h3 class="elixir-name mono">PRISMATIC ELIXIR</h3>
            <p class="elixir-desc">Crystallized light itself. Skips one rarity tier entirely and adds holographic shimmer.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">+2 Tiers (skip one)</span></div>
              <div class="elixir-stat"><span class="stat-key">Visual:</span> <span class="stat-val">Holographic rainbow border</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">8%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+1.0x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Mythic Elixir -->
        <a href="/elixir/mythic" class="elixir-link">
        <article class="elixir-card card-retro-neon mythic-card" style="--elixir-color: #ff0080;">
          <div class="elixir-bottle-wrap">
            <div class="bottle mythic-bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid mythic-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow mythic-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge mythic-badge">MYTHIC</span>
            <h3 class="elixir-name mono">MYTHIC ELIXIR</h3>
            <p class="elixir-desc">The rarest substance in existence. Instantly elevates any card to Mythic with full visual overhaul.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">Instant Mythic</span></div>
              <div class="elixir-stat"><span class="stat-key">Visual:</span> <span class="stat-val">Complete transformation + crown</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">2%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+2.0x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- ── EDUCATION ELIXIRS ── -->

        <!-- Apprentice Elixir -->
        <a href="/elixir/apprentice" class="elixir-link">
        <article class="elixir-card card-retro-neon" style="--elixir-color: #2ecc71;">
          <div class="elixir-bottle-wrap">
            <div class="bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge apprentice-badge">APPRENTICE</span>
            <h3 class="elixir-name mono">APPRENTICE ELIXIR</h3>
            <p class="elixir-desc">First stage of mastery. Complete foundational education modules to unlock higher service compensation rates.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">Service Tier I</span></div>
              <div class="elixir-stat"><span class="stat-key">Compensation:</span> <span class="stat-val neon-text">+25% Rate</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">20%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+0.25x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Scholar Elixir -->
        <a href="/elixir/scholar" class="elixir-link">
        <article class="elixir-card card-retro-neon" style="--elixir-color: #4169e1;">
          <div class="elixir-bottle-wrap">
            <div class="bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge scholar-badge">SCHOLAR</span>
            <h3 class="elixir-name mono">SCHOLAR ELIXIR</h3>
            <p class="elixir-desc">Second stage of mastery. Intermediate specialization unlocks advanced service roles and elevated rates.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">Service Tier II</span></div>
              <div class="elixir-stat"><span class="stat-key">Compensation:</span> <span class="stat-val neon-text">+50% Rate</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">12%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+0.50x</span></div>
            </div>
          </div>
        </article>
        </a>

        <!-- Sage Elixir -->
        <a href="/elixir/sage" class="elixir-link">
        <article class="elixir-card card-retro-neon sage-card" style="--elixir-color: #f59e0b;">
          <div class="elixir-bottle-wrap">
            <div class="bottle sage-bottle">
              <div class="bottle-neck"></div>
              <div class="bottle-body">
                <div class="bottle-liquid sage-liquid"></div>
                <div class="bottle-bubble b1"></div>
                <div class="bottle-bubble b2"></div>
                <div class="bottle-bubble b3"></div>
              </div>
              <div class="bottle-glow sage-glow"></div>
            </div>
          </div>
          <div class="elixir-info">
            <span class="elixir-rarity-badge sage-badge">SAGE</span>
            <h3 class="elixir-name mono">SAGE ELIXIR</h3>
            <p class="elixir-desc">Final stage of mastery. Full certification grants maximum compensation and mentorship authority.</p>
            <div class="elixir-stats mono">
              <div class="elixir-stat"><span class="stat-key">Effect:</span> <span class="stat-val">Service Tier III</span></div>
              <div class="elixir-stat"><span class="stat-key">Compensation:</span> <span class="stat-val neon-text">+100% Rate</span></div>
              <div class="elixir-stat"><span class="stat-key">Drop Rate:</span> <span class="stat-val">5%</span></div>
              <div class="elixir-stat"><span class="stat-key">XP Boost:</span> <span class="stat-val neon-text">+1.0x</span></div>
            </div>
          </div>
        </article>
        </a>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION 3: TRANSFORMATION PREVIEW -->
  <!-- ============================================ -->
  <section class="transform-section retro-ascii-section">
    <div class="container mx-auto">
      <h2 class="section-title mono neon-text">[ TRANSFORMATION PREVIEW ]</h2>
      <p class="section-subtitle mono text-muted">See what elixirs do to your Rapper PFP cards</p>

      <!-- Tier Selector Tabs -->
      <div class="transform-tabs" id="transform-tabs">
        <button class="transform-tab active" data-from="common" data-to="uncommon">Common &rarr; Uncommon</button>
        <button class="transform-tab" data-from="uncommon" data-to="rare">Uncommon &rarr; Rare</button>
        <button class="transform-tab" data-from="rare" data-to="legendary">Rare &rarr; Legendary</button>
        <button class="transform-tab" data-from="legendary" data-to="mythic">Legendary &rarr; Mythic</button>
      </div>

      <!-- Before / After Display -->
      <div class="transform-comparison">
        <div class="transform-card" id="before-card">
          <div class="card-label mono">BEFORE</div>
          <div class="pfp-frame" id="pfp-before" style="--card-color: #cd7f32;">
            <div class="pfp-header">
              <span class="pfp-id mono">#0127</span>
              <span class="pfp-rarity mono" id="before-rarity">COMMON</span>
            </div>
            <div class="pfp-avatar" id="before-avatar">
              <div class="pfp-avatar-inner">MC</div>
            </div>
            <div class="pfp-name mono" id="before-name">ROOKIE MC</div>
            <div class="pfp-record mono">Record: 3-2-1</div>
            <div class="pfp-badges" id="before-badges">
              <span class="pfp-badge">&#x1F949;</span>
            </div>
            <div class="pfp-stat-bar">
              <div class="pfp-stat-fill" id="before-stat" style="width: 20%;"></div>
            </div>
          </div>
        </div>

        <div class="transform-middle">
          <div class="elixir-apply-icon" id="elixir-icon">
            <div class="apply-bottle">
              <div class="apply-liquid"></div>
            </div>
          </div>
          <button class="btn-retro-neon transform-btn pulse-glow" id="btn-transform">
            APPLY ELIXIR
          </button>
        </div>

        <div class="transform-card" id="after-card">
          <div class="card-label mono">AFTER</div>
          <div class="pfp-frame" id="pfp-after" style="--card-color: #00ffff;">
            <div class="pfp-header">
              <span class="pfp-id mono">#0127</span>
              <span class="pfp-rarity mono" id="after-rarity">UNCOMMON</span>
            </div>
            <div class="pfp-avatar upgraded" id="after-avatar">
              <div class="pfp-avatar-inner">MC</div>
            </div>
            <div class="pfp-name mono" id="after-name">RISING MC</div>
            <div class="pfp-record mono">Record: 3-2-1</div>
            <div class="pfp-badges" id="after-badges">
              <span class="pfp-badge">&#x1F948;</span>
              <span class="pfp-badge">&#x2728;</span>
            </div>
            <div class="pfp-stat-bar">
              <div class="pfp-stat-fill" id="after-stat" style="width: 40%;"></div>
            </div>
          </div>
        </div>
      </div>

      <!-- Stat Changes -->
      <div class="stat-changes card-retro">
        <h3 class="mono neon-text">STAT CHANGES</h3>
        <div class="stat-change-grid" id="stat-changes">
          <div class="stat-change">
            <span class="sc-label mono">XP Multiplier</span>
            <span class="sc-before mono" id="sc-xp-before">1.0x</span>
            <span class="sc-arrow">&rarr;</span>
            <span class="sc-after mono neon-text" id="sc-xp-after">1.25x</span>
          </div>
          <div class="stat-change">
            <span class="sc-label mono">Voting Power</span>
            <span class="sc-before mono" id="sc-vp-before">1</span>
            <span class="sc-arrow">&rarr;</span>
            <span class="sc-after mono neon-text" id="sc-vp-after">2</span>
          </div>
          <div class="stat-change">
            <span class="sc-label mono">Airdrop Boost</span>
            <span class="sc-before mono" id="sc-ab-before">+0%</span>
            <span class="sc-arrow">&rarr;</span>
            <span class="sc-after mono neon-text" id="sc-ab-after">+5%</span>
          </div>
          <div class="stat-change">
            <span class="sc-label mono">Badge</span>
            <span class="sc-before mono" id="sc-badge-before">&#x1F949;</span>
            <span class="sc-arrow">&rarr;</span>
            <span class="sc-after mono" id="sc-badge-after">&#x1F948;</span>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ============================================ -->
  <!-- SECTION 4: HOW TO EARN -->
  <!-- ============================================ -->
  <section class="earn-section">
    <div class="container mx-auto">
      <h2 class="section-title mono neon-text">[ HOW TO EARN ELIXIRS ]</h2>
      <p class="section-subtitle mono text-muted">Multiple paths to power up your collection</p>

      <div class="earn-grid">
        <!-- XP Milestones -->
        <div class="earn-card card-retro">
          <div class="earn-icon">&#x1F3C6;</div>
          <h3 class="earn-title mono">XP MILESTONES</h3>
          <p class="earn-desc">Reach key levels to earn elixirs automatically</p>
          <ul class="earn-list mono">
            <li><span class="earn-level">Lv 10</span> <span class="earn-reward" style="color: #c850ff;">1x Rarity Elixir</span></li>
            <li><span class="earn-level">Lv 25</span> <span class="earn-reward" style="color: #00e5ff;">1x Chrono Elixir</span></li>
            <li><span class="earn-level">Lv 50</span> <span class="earn-reward" style="color: #ff4500;">1x Phoenix Elixir</span></li>
            <li><span class="earn-level">Lv 75</span> <span class="earn-reward" style="color: #a855f7;">1x Prismatic Elixir</span></li>
            <li><span class="earn-level">Lv 100</span> <span class="earn-reward" style="color: #ff0080;">1x Mythic Elixir</span></li>
          </ul>
          <div class="earn-status active-badge">ACTIVE</div>
        </div>

        <!-- Battle Victories -->
        <div class="earn-card card-retro">
          <div class="earn-icon">&#x2694;&#xFE0F;</div>
