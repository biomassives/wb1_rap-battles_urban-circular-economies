      .elixir-hero { padding: 3rem 1rem; }
      .hero-terminal { font-size: 0.85rem; padding: 1rem; }

      .elixir-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
      .elixir-card { padding: 1rem; }
      .elixir-bottle-wrap { width: 60px; height: 90px; }
      .bottle-body { width: 45px; height: 60px; }
      .bottle-neck { width: 18px; height: 24px; }
      .elixir-name { font-size: 0.9rem; }
      .elixir-desc { font-size: 0.75rem; }
      .elixir-stats { font-size: 0.7rem; }

      .transform-comparison { flex-direction: column; gap: 1.5rem; }
      .pfp-frame { width: 180px; }

      .transform-tabs { gap: 0.35rem; }
      .transform-tab { font-size: 0.7rem; padding: 0.5rem 0.75rem; }

      .stat-change-grid { grid-template-columns: 1fr; }

      .earn-grid { grid-template-columns: 1fr; }
      .teaser-grid { grid-template-columns: 1fr; }

      .elixir-nav { flex-direction: column; align-items: center; }
      .elixir-nav a { width: 80%; text-align: center; }
    }

    @media (max-width: 480px) {
      .elixir-grid { grid-template-columns: 1fr; }
      .section-title { font-size: 1.75rem; letter-spacing: 2px; }
    }
  </style>

  <script is:inline>
  (function() {
    // ── TIER DATA ──
    const TIERS = {
      common:    { color: '#cd7f32', label: 'COMMON',    badge: '\u{1F949}',      name: 'ROOKIE MC',    xp: '1.0x',  vp: '1', ab: '+0%',  stat: 20 },
      uncommon:  { color: '#00ffff', label: 'UNCOMMON',  badge: '\u{1F948}\u2728', name: 'RISING MC',    xp: '1.25x', vp: '2', ab: '+5%',  stat: 40 },
      rare:      { color: '#ffff00', label: 'RARE',      badge: '\u2B50\u{1F525}', name: 'VETERAN MC',   xp: '1.5x',  vp: '3', ab: '+10%', stat: 60 },
      legendary: { color: '#ff00ff', label: 'LEGENDARY', badge: '\u{1F48E}\u26A1\u{1F451}', name: 'ELITE MC', xp: '2.0x', vp: '4', ab: '+20%', stat: 80 },
      mythic:    { color: '#ff0080', label: 'MYTHIC',    badge: '\u{1F451}\u{1F48E}\u26A1\u{1F525}\u{1F3C6}', name: 'LEGEND MC', xp: '3.0x', vp: '5', ab: '+50%', stat: 100 }
    };

    const TIER_ORDER = ['common', 'uncommon', 'rare', 'legendary', 'mythic'];

    let currentFrom = 'common';
    let currentTo = 'uncommon';
    let isAnimating = false;

    function updatePreview(from, to) {
      const f = TIERS[from];
      const t = TIERS[to];
      if (!f || !t) return;

      // Before card
      const pfpBefore = document.getElementById('pfp-before');
      pfpBefore.style.setProperty('--card-color', f.color);
      document.getElementById('before-rarity').textContent = f.label;
      document.getElementById('before-name').textContent = f.name;
      document.getElementById('before-badges').innerHTML = f.badge.split('').map(b => '<span class="pfp-badge">' + b + '</span>').join('');
      document.getElementById('before-stat').style.width = f.stat + '%';
      document.getElementById('before-avatar').className = 'pfp-avatar';
      document.getElementById('before-avatar').querySelector('.pfp-avatar-inner').style.color = f.color;
      pfpBefore.className = 'pfp-frame';

      // After card
      const pfpAfter = document.getElementById('pfp-after');
      pfpAfter.style.setProperty('--card-color', t.color);
      document.getElementById('after-rarity').textContent = t.label;
      document.getElementById('after-name').textContent = t.name;
      document.getElementById('after-badges').innerHTML = t.badge.split('').map(b => '<span class="pfp-badge">' + b + '</span>').join('');
      document.getElementById('after-stat').style.width = t.stat + '%';
      document.getElementById('after-avatar').className = 'pfp-avatar upgraded';
      document.getElementById('after-avatar').querySelector('.pfp-avatar-inner').style.color = t.color;
      pfpAfter.className = 'pfp-frame';

      // Stats
      document.getElementById('sc-xp-before').textContent = f.xp;
      document.getElementById('sc-xp-after').textContent = t.xp;
      document.getElementById('sc-vp-before').textContent = f.vp;
      document.getElementById('sc-vp-after').textContent = t.vp;
      document.getElementById('sc-ab-before').textContent = f.ab;
      document.getElementById('sc-ab-after').textContent = t.ab;
      document.getElementById('sc-badge-before').textContent = f.badge;
      document.getElementById('sc-badge-after').textContent = t.badge;
    }

    function setupTransformTabs() {
      document.querySelectorAll('.transform-tab').forEach(function(tab) {
        tab.addEventListener('click', function() {
          if (isAnimating) return;
          document.querySelectorAll('.transform-tab').forEach(function(t) { t.classList.remove('active'); });
          tab.classList.add('active');
          currentFrom = tab.dataset.from;
          currentTo = tab.dataset.to;
          updatePreview(currentFrom, currentTo);
        });
      });
    }

    function setupTransformButton() {
      var btn = document.getElementById('btn-transform');
      if (!btn) return;

      btn.addEventListener('click', function() {
        if (isAnimating) return;
        isAnimating = true;

        var pfpBefore = document.getElementById('pfp-before');
        var pfpAfter = document.getElementById('pfp-after');

        // Reset after card to look like before
        var f = TIERS[currentFrom];
        pfpAfter.style.setProperty('--card-color', f.color);
        document.getElementById('after-rarity').textContent = f.label;
        document.getElementById('after-name').textContent = f.name;
        document.getElementById('after-avatar').querySelector('.pfp-avatar-inner').style.color = f.color;

        // Animate before card out
        pfpBefore.classList.add('transforming-out');

        setTimeout(function() {
          // Now update after card to target tier
          var t = TIERS[currentTo];
          pfpAfter.style.setProperty('--card-color', t.color);
          document.getElementById('after-rarity').textContent = t.label;
          document.getElementById('after-name').textContent = t.name;
          document.getElementById('after-badges').innerHTML = t.badge.split('').map(function(b) { return '<span class="pfp-badge">' + b + '</span>'; }).join('');
          document.getElementById('after-stat').style.width = t.stat + '%';
          document.getElementById('after-avatar').querySelector('.pfp-avatar-inner').style.color = t.color;

          pfpAfter.classList.add('transforming-in');
        }, 600);

        setTimeout(function() {
          pfpBefore.classList.remove('transforming-out');
          pfpAfter.classList.remove('transforming-in');
          updatePreview(currentFrom, currentTo);
          isAnimating = false;
        }, 1600);
      });
    }

    function init() {
      setupTransformTabs();
      setupTransformButton();
      updatePreview(currentFrom, currentTo);
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
  </script>

</BaseLayout>
