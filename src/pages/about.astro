---
/**
 * about.astro - About WorldBridger One
 * Platform explainer with honest feature status, internal links, and testnet invite
 */
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About WorldBridger One" activeSection="about">
  <main class="about-page">

    <!-- Hero Section -->
    <section class="about-hero">
      <div class="container">
        <div class="hero-badge">
          <span class="badge-icon">&#x1F3A4;</span>
          <span class="badge-text">Community Owned Music Platform</span>
        </div>
        <h1 class="hero-title">
          <span class="title-line">Create. Battle.</span>
          <span class="title-line accent">Earn. Own.</span>
        </h1>
        <p class="hero-description">
          WorldBridger One is an <strong>open source</strong> music platform connecting
          youth communities through hip-hop culture, blockchain rewards, and environmental action.
          Built on Solana. Free forever. Currently inviting testnet participants.
        </p>
        <div class="hero-ctas">
          <a href="/#join-testnet" class="cta-primary">Join the Testnet</a>
          <a href="/invest" class="cta-secondary">Invest & Donate</a>
        </div>
        <div class="open-source-badges">
          <div class="license-badge"><span class="license-icon">&#x1F4DC;</span><span>MIT License</span></div>
          <div class="license-badge"><span class="license-icon">&#x1F513;</span><span>GPL v3</span></div>
          <div class="license-badge"><span class="license-icon">&#x1F310;</span><span>Solana Testnet</span></div>
          <div class="license-badge"><span class="license-icon">&#x1F49A;</span><span>Forever Free</span></div>
        </div>
      </div>
    </section>

    <!-- What is WorldBridger One -->
    <section class="explainer-section">
      <div class="container">
        <h2 class="section-title">What is WorldBridger One?</h2>
        <div class="explainer-grid">
          <div class="explainer-card">
            <div class="explainer-icon">&#x1F3B5;</div>
            <h3>Music Creation</h3>
            <p>Built-in Moog synthesizer, 16-pad drum sampler, beat mixer, and recording tools. Create original tracks, enter rap battles, and produce beats — all in your browser.</p>
          </div>
          <div class="explainer-card">
            <div class="explainer-icon">&#x2694;&#xFE0F;</div>
            <h3>Battle & Challenge System</h3>
            <p>1v1 rap battles, group challenges with invite codes, community voting, and XP rewards. Every win, vote, and submission counts toward your progression.</p>
          </div>
          <div class="explainer-card">
            <div class="explainer-icon">&#x1F48E;</div>
            <h3>XP Economy & NFTs</h3>
            <p>25+ activities earn XP. Six airdrop tiers from Bronze to Mythic determine your drop rarity and quantity. NFT collections include 55 animal spirits and custom rapper PFPs.</p>
          </div>
          <div class="explainer-card">
            <div class="explainer-icon">&#x1F30D;</div>
            <h3>Community Impact</h3>
            <p>Direct support for youth programs in Kakuma refugee camp and Nairobi. Citizen science data collection, mentoring sessions, and environmental action — all rewarded with XP.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- What's Live Now -->
    <section class="live-section">
      <div class="container">
        <h2 class="section-title">
          <span class="status-dot live"></span>
          What's Live Now
        </h2>
        <p class="section-subtitle">These features are built, deployed, and usable today</p>

        <div class="features-grid">
          <a href="/rap-battle" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x2694;&#xFE0F;</span><h4>Rap Battles</h4><p>1v1 and group battles with XP rewards and community voting</p></div>
          </a>
          <a href="/challenge-arena" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3AF;</span><h4>Challenge Arena</h4><p>Create & join challenges with 6-char invite codes</p></div>
          </a>
          <a href="/beat-playground" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3B6;</span><h4>Beat Playground</h4><p>Multi-layer beat mixing with BPM controls and export</p></div>
          </a>
          <a href="/sampler" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3B9;</span><h4>Drum Sampler</h4><p>16-pad drum machine with sound library</p></div>
          </a>
          <a href="/music-studio" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3B5;</span><h4>Music Studio</h4><p>Moog synth + sampler + looper in one workspace</p></div>
          </a>
          <a href="/elixir" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F9EA;</span><h4>Elixir Lab</h4><p>8 elixirs for card transformation and education tiers</p></div>
          </a>
          <a href="/nft-gallery" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3A8;</span><h4>NFT Gallery</h4><p>55 animal spirit rapper collection with generated sounds</p></div>
          </a>
          <a href="/rapper-template-builder" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F464;</span><h4>Rapper PFP Builder</h4><p>Design your own rapper card with custom traits</p></div>
          </a>
          <a href="/training-quiz" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F4DD;</span><h4>Training Quiz</h4><p>Learn hip-hop, sustainability, and culture — earn certs</p></div>
          </a>
          <a href="/airdrops" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F4E6;</span><h4>XP & Airdrops</h4><p>25+ XP activities, 6 tiers, scheduled reward drops</p></div>
          </a>
          <a href="/leaderboard" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3C6;</span><h4>Leaderboard</h4><p>Global XP rankings and achievement tracking</p></div>
          </a>
          <a href="/profile" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F464;</span><h4>Profile Dashboard</h4><p>XP progress, rewards, wallet, and activity history</p></div>
          </a>
          <a href="/projects" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F680;</span><h4>Projects Hub</h4><p>Discover and fund community initiatives</p></div>
          </a>
          <a href="/invest" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F49A;</span><h4>Invest & Donate</h4><p>Fund projects or donate — both mint Donor NFTs</p></div>
          </a>
          <a href="/kakuma" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3D5;&#xFE0F;</span><h4>Kakuma Impact</h4><p>Youth programs in Kakuma refugee camp</p></div>
          </a>
          <a href="/nairobi-youth" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F3D9;&#xFE0F;</span><h4>Nairobi Youth</h4><p>Urban youth programs and creative workshops</p></div>
          </a>
          <a href="/learn" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F4DA;</span><h4>Learning Hub</h4><p>Courses, tutorials, and skill development resources</p></div>
          </a>
          <a href="/progress" class="feature-link">
            <div class="feature-card"><span class="feature-emoji">&#x1F4C8;</span><h4>Progress Tracker</h4><p>Track your growth across all platform activities</p></div>
          </a>
        </div>
      </div>
    </section>

    <!-- In Testing -->
    <section class="testing-section">
      <div class="container">
        <h2 class="section-title">
          <span class="status-dot testing"></span>
          In Active Testing
        </h2>
        <p class="section-subtitle">These features are built and being tested with our early community</p>

        <div class="testing-grid">
          <div class="testing-card">
            <div class="testing-icon">&#x26D3;&#xFE0F;</div>
            <h4>NFT Minting on Solana Testnet</h4>
            <p>Metaplex integration in progress. On-chain minting for rapper PFPs, donor NFTs, and achievement badges being activated.</p>
            <span class="testing-status">Metaplex Integration</span>
          </div>
          <div class="testing-card">
            <div class="testing-icon">&#x1F3EA;</div>
            <h4>NFT Marketplace</h4>
            <p>Buy, sell, and trade NFTs with other community members. Fixed price and auction formats supported.</p>
            <span class="testing-status">Backend Ready</span>
          </div>
          <div class="testing-card">
            <div class="testing-icon">&#x1F9EA;</div>
            <h4>Elixir Transformation</h4>
            <p>Apply elixirs to upgrade Rapper PFP card rarity and visual appearance. Education elixirs unlock service compensation tiers.</p>
            <span class="testing-status">Showcase Mode</span>
          </div>
          <div class="testing-card">
            <div class="testing-icon">&#x1F3DB;&#xFE0F;</div>
            <h4>DAO Governance</h4>
            <p>On-chain governance proposals and token-weighted voting. Community members direct platform development and treasury allocation.</p>
            <span class="testing-status">API Built</span>
          </div>
          <div class="testing-card">
            <div class="testing-icon">&#x1F4B3;</div>
            <h4>Donor NFT Minting</h4>
            <p>Every investment and donation mints a tiered Donor NFT (Bronze through Platinum) to the contributor's wallet.</p>
            <span class="testing-status">Mock Minting Active</span>
          </div>
          <div class="testing-card">
            <div class="testing-icon">&#x1F393;</div>
            <h4>Education Service Tiers</h4>
            <p>Complete learning modules to earn Apprentice, Scholar, and Sage elixirs — unlocking higher compensation rates for platform services.</p>
            <span class="testing-status">System Designed</span>
          </div>
        </div>
      </div>
    </section>

    <!-- Roadmap -->
    <section class="roadmap-section">
      <div class="container">
        <h2 class="section-title">Roadmap</h2>
        <div class="roadmap-timeline">
          <div class="roadmap-item current">
            <div class="roadmap-marker"></div>
            <div class="roadmap-content">
              <h4>Q1 2026 <span class="roadmap-badge current-badge">NOW</span></h4>
              <p>Solana testnet minting live. Metaplex integration. Donor NFT system. Community testing with Kakuma & Nairobi youth.</p>
            </div>
          </div>
          <div class="roadmap-item">
            <div class="roadmap-marker"></div>
            <div class="roadmap-content">
              <h4>Q2 2026</h4>
              <p>Mainnet launch. Elixir marketplace. Mentor/Teacher certification roles. NFT staking for project boosts.</p>
            </div>
          </div>
          <div class="roadmap-item">
            <div class="roadmap-marker"></div>
            <div class="roadmap-content">
              <h4>Q3 2026</h4>
              <p>Exotopia virtual property NFTs. Peace Engineering hub. Cross-community exchange programs.</p>
            </div>
          </div>
          <div class="roadmap-item">
            <div class="roadmap-marker"></div>
            <div class="roadmap-content">
              <h4>Q4 2026</h4>
              <p>EcoCity sustainable systems NFTs. Multi-chain expansion (Polygon, Near, Tezos, Celo). Revenue sharing for Platinum donors.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Roles Section -->
    <section class="roles-section">
      <div class="container">
        <h2 class="section-title">Available Roles</h2>
        <p class="section-subtitle">Choose your path and start contributing</p>

        <div class="roles-grid">
          <div class="role-category">
            <h3 class="category-title active">
              <span class="status-dot live"></span>
              Active Now
            </h3>

            <div class="role-card active">
              <div class="role-icon">&#x1F3A4;</div>
              <div class="role-content">
                <h4>Artist / Rapper</h4>
                <p>Create beats, record battles, earn XP and NFTs.</p>
                <a href="/rap-battle" class="role-cta">Start Battle &rarr;</a>
              </div>
            </div>

            <div class="role-card active">
              <div class="role-icon">&#x1F3A7;</div>
              <div class="role-content">
                <h4>Beat Producer</h4>
                <p>Use the sampler and Moog synth to create original beats.</p>
                <a href="/sampler" class="role-cta">Open Sampler &rarr;</a>
              </div>
            </div>

            <div class="role-card active">
              <div class="role-icon">&#x2696;&#xFE0F;</div>
              <div class="role-content">
                <h4>Judge / Voter</h4>
                <p>Vote on battles, rate performances, help determine winners.</p>
                <a href="/rap-battle" class="role-cta">Vote Now &rarr;</a>
              </div>
            </div>

            <div class="role-card active">
              <div class="role-icon">&#x1F3A8;</div>
              <div class="role-content">
                <h4>NFT Collector</h4>
                <p>Collect PFP cards, support artists, invest in projects.</p>
                <a href="/nft-gallery" class="role-cta">Browse NFTs &rarr;</a>
              </div>
            </div>

            <div class="role-card active">
              <div class="role-icon">&#x1F49A;</div>
              <div class="role-content">
                <h4>Impact Supporter</h4>
                <p>Donate, invest, and support youth programs.</p>
                <a href="/invest" class="role-cta">Invest & Donate &rarr;</a>
              </div>
            </div>
          </div>

          <div class="role-category">
            <h3 class="category-title coming">
              <span class="status-dot testing"></span>
              Coming Soon
            </h3>

            <div class="role-card coming">
              <div class="role-icon">&#x1F468;&#x200D;&#x1F3EB;</div>
              <div class="role-content">
                <h4>Mentor / Teacher</h4>
                <p>Guide new artists, earn Sage elixir for higher compensation.</p>
                <span class="coming-badge">Q2 2026</span>
              </div>
            </div>

            <div class="role-card coming">
              <div class="role-icon">&#x1F6E0;&#xFE0F;</div>
              <div class="role-content">
                <h4>Solution Builder</h4>
                <p>Contribute sustainable solutions to the SCD Hub database.</p>
                <span class="coming-badge">Q2 2026</span>
              </div>
            </div>

            <div class="role-card coming">
              <div class="role-icon">&#x262E;&#xFE0F;</div>
              <div class="role-content">
                <h4>Peace Engineer</h4>
                <p>Design community conflict resolution programs.</p>
                <span class="coming-badge">Q3 2026</span>
              </div>
            </div>

            <div class="role-card coming">
              <div class="role-icon">&#x1F4CA;</div>
              <div class="role-content">
                <h4>Data Contributor</h4>
                <p>Map resources, document solutions, maintain databases.</p>
                <span class="coming-badge">Q3 2026</span>
              </div>
            </div>

            <div class="role-card coming">
              <div class="role-icon">&#x1F3DB;&#xFE0F;</div>
              <div class="role-content">
                <h4>DAO Governor</h4>
                <p>Vote on platform decisions and allocate treasury.</p>
                <span class="coming-badge">Q4 2026</span>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Integrated Hubs -->
    <section class="hubs-section">
      <div class="container">
        <h2 class="section-title">Integrated Hubs</h2>
        <p class="section-subtitle">Connected platforms for learning, impact, and sustainable development</p>

        <div class="hubs-grid">
          <div class="hub-card approvideo">
            <div class="hub-header">
              <div class="hub-icon">&#x1F4FA;</div>
              <div class="hub-status integrated">Integrated</div>
            </div>
            <h3 class="hub-title">Approvideo Learning Hub</h3>
            <p class="hub-description">Video-based learning for skill development. Tutorials, courses, and certificates from community mentors.</p>
            <a href="/learn" class="hub-cta">Start Learning &rarr;</a>
          </div>

          <div class="hub-card peace">
            <div class="hub-header">
              <div class="hub-icon">&#x262E;&#xFE0F;</div>
              <div class="hub-status building">Building</div>
            </div>
            <h3 class="hub-title">Peace Engineering</h3>
            <p class="hub-description">Conflict resolution frameworks, community mediation, and creative expression as a peace-building tool.</p>
            <a href="/impact" class="hub-cta">Learn More &rarr;</a>
          </div>

          <div class="hub-card scd">
            <div class="hub-header">
              <div class="hub-icon">&#x1F5C3;&#xFE0F;</div>
              <div class="hub-status building">Building</div>
            </div>
            <h3 class="hub-title">SCD Hub Solutions Database</h3>
            <p class="hub-description">Sustainable community development database cataloging proven solutions for water, energy, agriculture, and infrastructure.</p>
            <a href="/solutions" class="hub-cta">Browse Solutions &rarr;</a>
          </div>
        </div>
      </div>
    </section>

    <!-- Tech Stack -->
    <section class="tech-section">
      <div class="container">
        <h2 class="section-title">Built in the Open</h2>
        <p class="section-subtitle">Open source tools, permissive licenses. Fork it, improve it, deploy your own.</p>

        <div class="tech-grid">
          <div class="tech-item">
            <h4>Astro 5.x</h4>
            <p>SSR framework with Vercel adapter</p>
          </div>
          <div class="tech-item">
            <h4>Solana Web3.js</h4>
            <p>Wallet integration & blockchain interactions</p>
          </div>
          <div class="tech-item">
            <h4>Neon PostgreSQL</h4>
            <p>Serverless database for all platform data</p>
          </div>
          <div class="tech-item">
            <h4>Web Audio API</h4>
            <p>Browser-native music creation and recording</p>
          </div>
          <div class="tech-item">
            <h4>Three.js</h4>
            <p>3D visualizations and interactive elements</p>
          </div>
          <div class="tech-item highlight">
            <h4>Metaplex</h4>
            <p>NFT minting & metadata — in integration</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Join CTA -->
    <section class="join-section">
      <div class="container">
        <div class="join-banner">
          <h2>Ready to join?</h2>
          <p>Sign up for testnet notifications, create a wallet, or start making music right now.</p>
          <div class="join-actions">
            <a href="/#join-testnet" class="cta-primary">Join the Testnet</a>
            <a href="/rap-battle" class="cta-secondary">Start a Battle</a>
            <a href="/invest" class="cta-secondary">Invest & Donate</a>
          </div>
        </div>
      </div>
    </section>

    <!-- SparkHope -->
    <section class="sparkhope-section">
      <div class="container">
        <div class="sparkhope-banner">
          <div class="sparkhope-icon">&#x1F344;</div>
          <div class="sparkhope-text">
            <h3>Part of SparkHope.space</h3>
            <p>Integrated with the SparkHope mycological innovation platform, connecting creative expression with regenerative agriculture and sustainable community development.</p>
          </div>
          <a href="https://sparkhope.space" class="sparkhope-link" target="_blank" rel="noopener">Visit SparkHope &rarr;</a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .about-page {
    background: #0a0a0a;
    color: #fff;
    min-height: 100vh;
  }

  .container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero */
  .about-hero {
    padding: 6rem 0 4rem;
    text-align: center;
    background: linear-gradient(180deg, #1a1a2e 0%, #0a0a0a 100%);
    border-bottom: 2px solid #333;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    background: rgba(0, 255, 0, 0.1);
    border: 1px solid #00ff00;
    padding: 8px 20px;
    margin-bottom: 2rem;
    font-family: 'Courier New', monospace;
    font-size: 0.875rem;
    color: #00ff00;
  }

  .hero-title {
    font-size: 3.5rem;
    font-weight: 900;
    line-height: 1.1;
    margin-bottom: 1.5rem;
    font-family: 'Courier New', monospace;
  }

  .title-line { display: block; }
  .title-line.accent { color: #00ff00; text-shadow: 0 0 20px rgba(0, 255, 0, 0.5); }

  .hero-description {
    font-size: 1.15rem;
    color: #aaa;
    max-width: 700px;
    margin: 0 auto 2rem;
    line-height: 1.7;
  }

  .hero-description strong { color: #00ff00; }

  .hero-ctas {
    display: flex;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 2rem;
  }

  .cta-primary {
    background: #00ff00;
    color: #000;
    padding: 12px 28px;
    font-family: 'Courier New', monospace;
    font-weight: 900;
    font-size: 0.9rem;
    text-decoration: none;
    border: 2px solid #00ff00;
    letter-spacing: 1px;
    transition: all 0.2s;
  }

  .cta-primary:hover { box-shadow: 0 0 20px rgba(0, 255, 0, 0.5); }

  .cta-secondary {
    background: transparent;
    color: #aaa;
    padding: 12px 28px;
    font-family: 'Courier New', monospace;
    font-weight: 900;
    font-size: 0.9rem;
    text-decoration: none;
    border: 2px solid #444;
    letter-spacing: 1px;
    transition: all 0.2s;
  }

  .cta-secondary:hover { border-color: #888; color: #fff; }

  .open-source-badges {
    display: flex;
    justify-content: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .license-badge {
    display: flex;
    align-items: center;
    gap: 8px;
    background: #1a1a1a;
    border: 1px solid #333;
    padding: 10px 16px;
    font-family: 'Courier New', monospace;
    font-size: 0.8rem;
  }

  /* Section styles */
  .section-title {
    text-align: center;
    font-size: 2.25rem;
    font-weight: 900;
    margin-bottom: 1rem;
    font-family: 'Courier New', monospace;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 12px;
  }

  .section-subtitle {
    text-align: center;
    color: #888;
    font-size: 1rem;
    margin-bottom: 3rem;
  }

  .status-dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    display: inline-block;
  }

  .status-dot.live { background: #00ff00; box-shadow: 0 0 10px #00ff00; }
  .status-dot.testing { background: #ff00ff; box-shadow: 0 0 10px #ff00ff; }

  /* Explainer / Mission */
  .explainer-section {
    padding: 5rem 0;
    background: #111;
  }

  .explainer-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .explainer-card {
    background: #1a1a1a;
    border: 2px solid #333;
    padding: 2rem;
    text-align: center;
    transition: all 0.3s;
  }

  .explainer-card:hover { border-color: #00ff00; transform: translateY(-5px); }
  .explainer-icon { font-size: 3rem; margin-bottom: 1rem; }
  .explainer-card h3 { font-size: 1.15rem; margin-bottom: 0.75rem; color: #00ff00; }
  .explainer-card p { color: #888; line-height: 1.6; font-size: 0.9rem; }

  /* Live Features Grid */
  .live-section {
    padding: 5rem 0;
    background: #0a0a0a;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .feature-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

