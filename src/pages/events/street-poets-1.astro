---
/**
 * events/street-poets-1.astro
 * Post-Event Review: Fana Ke x Street Poets - Rap Battle Series (Event #1)
 *
 * Template for documenting and reviewing the first Street Poets rap battle event.
 * This serves as a reusable template structure for future event reviews.
 */

import BaseLayout from '../../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Street Poets #1 - Event Review"
  description="Post-event review of the first Fana Ke x Street Poets rap battle in Nairobi"
  activeSection="nairobi-youth"
>

  <!-- EVENT HERO -->
  <section class="event-hero">
    <div class="container mx-auto">
      <div class="event-hero-content">
        <div class="event-badge">Post-Event Review</div>
        <h1 class="event-title">Fana Ke x Street Poets</h1>
        <h2 class="event-subtitle">Rap Battle Series - Event #1</h2>

        <div class="event-meta">
          <div class="meta-item">
            <span class="meta-icon">📍</span>
            <span>Nairobi, Kenya</span>
          </div>
          <div class="meta-item">
            <span class="meta-icon">📅</span>
            <span id="event-date">Date TBC</span>
          </div>
          <div class="meta-item">
            <span class="meta-icon">🎤</span>
            <span>Rap Battle / Live Performance</span>
          </div>
        </div>

        <a href="/nairobi-youth" class="back-link">← Back to Urban & Coastal Youth</a>
      </div>
    </div>
  </section>

  <!-- EVENT SUMMARY -->
  <section class="event-section">
    <div class="container mx-auto">
      <h2 class="section-heading">Event Summary</h2>

      <div class="summary-grid">
        <div class="summary-card">
          <div class="summary-number" id="total-attendees">0</div>
          <div class="summary-label">Attendees</div>
        </div>
        <div class="summary-card">
          <div class="summary-number" id="total-performers">0</div>
          <div class="summary-label">Performers</div>
        </div>
        <div class="summary-card">
          <div class="summary-number" id="total-battles">0</div>
          <div class="summary-label">Battles</div>
        </div>
        <div class="summary-card">
          <div class="summary-number" id="total-sponsors">0</div>
          <div class="summary-label">Sponsors</div>
        </div>
      </div>
    </div>
  </section>

  <!-- EVENT OVERVIEW -->
  <section class="event-section light-bg">
    <div class="container mx-auto">
      <h2 class="section-heading">Overview</h2>

      <div class="content-block">
        <p class="body-text">
          The first Fana Ke x Street Poets rap battle brought together aspiring MCs, lyricists,
          and hip-hop enthusiasts from across Nairobi for a night of competitive rap, creative
          expression, and community building.
        </p>
        <p class="body-text">
          Street Poets is a platform created to give voice to Nairobi's urban youth through
          hip-hop culture. The rap battle format provides a stage for self-expression,
          storytelling, and artistic development in a supportive competitive environment.
        </p>
      </div>
    </div>
  </section>

  <!-- HIGHLIGHTS -->
  <section class="event-section">
    <div class="container mx-auto">
      <h2 class="section-heading">Event Highlights</h2>

      <div class="highlights-grid">
        <div class="highlight-card">
          <div class="highlight-icon">🎤</div>
          <h3 class="highlight-title">Battle Rounds</h3>
          <p class="highlight-text">
            Competitors went head-to-head in freestyle and written rap battles, judged by
            audience reaction and a panel. Each round showcased unique styles, wordplay,
            and storytelling from Nairobi's underground scene.
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-icon">🏆</div>
          <h3 class="highlight-title">Winners & Standouts</h3>
          <p class="highlight-text">
            Details of battle winners and standout performers to be added after event.
            Prizes and recognition awarded to top MCs.
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-icon">🤝</div>
          <h3 class="highlight-title">Community Impact</h3>
          <p class="highlight-text">
            Beyond competition, the event served as a gathering point for Nairobi's hip-hop
            community, fostering connections between artists, producers, and fans. Youth
            from multiple neighborhoods came together in a positive creative space.
          </p>
        </div>

        <div class="highlight-card">
          <div class="highlight-icon">📢</div>
          <h3 class="highlight-title">Sponsors & Partners</h3>
          <p class="highlight-text">
            Event sponsors and partners to be listed here. Their support makes it possible
            to provide a platform for youth expression and development.
          </p>
        </div>
      </div>
    </div>
  </section>

  <!-- PERFORMERS / PARTICIPANTS -->
  <section class="event-section light-bg">
    <div class="container mx-auto">
      <h2 class="section-heading">Performers & Participants</h2>

      <div class="content-block">
        <p class="body-text">
          Participant roster and battle results to be added after the event. Each performer
          brings their unique voice and perspective from Nairobi's diverse communities.
        </p>
      </div>

      <div class="participants-grid" id="participants-grid">
        <!-- Populated after event with participant cards -->
        <div class="empty-state">Participant details will be added after the event</div>
      </div>
    </div>
  </section>

  <!-- MEDIA GALLERY -->
  <section class="event-section">
    <div class="container mx-auto">
      <h2 class="section-heading">Event Gallery</h2>

      <div class="gallery-grid" id="gallery-grid">
        <div class="gallery-placeholder">
          <div class="placeholder-icon">📸</div>
          <p>Photos and videos from the event will be added here</p>
        </div>
      </div>
    </div>
  </section>

  <!-- LESSONS & NEXT STEPS -->
  <section class="event-section light-bg">
    <div class="container mx-auto">
      <h2 class="section-heading">Lessons Learned & Next Steps</h2>

      <div class="two-col-grid">
        <div class="content-card">
          <h3 class="card-heading">What Worked Well</h3>
          <ul class="checklist">
            <li>To be documented post-event</li>
          </ul>
        </div>

        <div class="content-card">
          <h3 class="card-heading">Areas for Improvement</h3>
          <ul class="checklist">
            <li>To be documented post-event</li>
          </ul>
        </div>
      </div>

      <div class="content-card next-steps-card">
        <h3 class="card-heading">Next Steps</h3>
        <div class="next-steps-list">
          <div class="step-item">
            <span class="step-number">1</span>
            <div>
              <strong>Event #2 Planning</strong>
              <p>Build on momentum from the first event to plan the next Street Poets battle</p>
            </div>
          </div>
          <div class="step-item">
            <span class="step-number">2</span>
            <div>
              <strong>Sponsor Outreach</strong>
              <p>Expand sponsor base to provide more prizes and better production</p>
            </div>
          </div>
          <div class="step-item">
            <span class="step-number">3</span>
            <div>
              <strong>Artist Development</strong>
              <p>Offer workshops and recording sessions for standout performers</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="event-section cta-section">
    <div class="container mx-auto text-center">
      <h2 class="section-heading light">Get Involved</h2>
      <p class="cta-text">
        Want to perform, sponsor, or attend the next Street Poets event?
      </p>
      <div class="cta-buttons">
        <a href="/nairobi-youth" class="btn-primary large">View All Programs</a>
        <button class="btn-secondary large" onclick="shareEvent()">Share This Event</button>
      </div>
    </div>
  </section>

</BaseLayout>

<script is:inline>
  function shareEvent() {
    const shareData = {
      title: 'Fana Ke x Street Poets - Rap Battle #1',
      text: 'Check out the first Street Poets rap battle event in Nairobi!',
      url: window.location.href
    };
    if (navigator.share) {
      navigator.share(shareData);
    } else {
      navigator.clipboard.writeText(shareData.url);
      alert('Link copied to clipboard!');
    }
  }

  window.shareEvent = shareEvent;
</script>

<style>
  /* ============================================ */
  /* EVENT REVIEW PAGE STYLES                     */
  /* ============================================ */

  .event-hero {
    background: linear-gradient(135deg, #7c3aed 0%, #a855f7 50%, #c084fc 100%);
    color: white;
    padding: 4rem 0 3rem;
  }

  .event-hero-content {
    max-width: 700px;
  }

  .event-badge {
    display: inline-block;
    background: rgba(255, 255, 255, 0.2);
    backdrop-filter: blur(10px);
    padding: 0.375rem 1rem;
    border-radius: 2rem;
    font-size: 0.875rem;
    font-weight: 600;
    margin-bottom: 1rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  .event-title {
    font-size: 3rem;
    font-weight: 900;
    margin-bottom: 0.5rem;
    line-height: 1.1;
  }

  .event-subtitle {
    font-size: 1.5rem;
    font-weight: 400;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .event-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .meta-item {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
    opacity: 0.9;
  }

  .meta-icon {
    font-size: 1.25rem;
  }

  .back-link {
    color: rgba(255, 255, 255, 0.8);
    text-decoration: none;
    font-size: 0.9rem;
    transition: color 0.2s;
  }

  .back-link:hover {
    color: white;
  }

  /* Sections */
  .event-section {
    padding: 3rem 0;
  }

  .event-section.light-bg {
    background: #f8fafc;
  }

  .event-section.cta-section {
    background: linear-gradient(135deg, #1e1b4b 0%, #312e81 100%);
    color: white;
  }

  .section-heading {
    font-size: 1.75rem;
    font-weight: 800;
    color: #1f2937;
    margin-bottom: 1.5rem;
  }

  .section-heading.light {
    color: white;
  }

  /* Summary Stats */
  .summary-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1.5rem;
    margin-bottom: 2rem;
  }

  .summary-card {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    text-align: center;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .summary-number {
    font-size: 2.5rem;
    font-weight: 900;
    color: #7c3aed;
    line-height: 1;
    margin-bottom: 0.5rem;
  }

  .summary-label {
    font-size: 0.875rem;
    color: #6b7280;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }

  /* Content */
  .content-block {
    max-width: 800px;
  }

  .body-text {
    color: #374151;
    font-size: 1.05rem;
    line-height: 1.7;
    margin-bottom: 1rem;
  }

  /* Highlights */
  .highlights-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
  }

  .highlight-card {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .highlight-icon {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .highlight-title {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 0.5rem;
  }

  .highlight-text {
    color: #4b5563;
    line-height: 1.6;
    font-size: 0.95rem;
  }

  /* Participants */
  .participants-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1rem;
  }

  .empty-state {
    grid-column: 1 / -1;
    text-align: center;
    color: #9ca3af;
    padding: 2rem;
    font-style: italic;
  }

  /* Gallery */
  .gallery-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(250px, 1fr));
    gap: 1rem;
  }

  .gallery-placeholder {
    grid-column: 1 / -1;
    background: #f3f4f6;
    border-radius: 1rem;
    padding: 3rem;
    text-align: center;
    border: 2px dashed #d1d5db;
  }

  .placeholder-icon {
    font-size: 3rem;
    margin-bottom: 0.5rem;
  }

  .gallery-placeholder p {
    color: #9ca3af;
  }

  /* Two-column layout */
  .two-col-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .content-card {
    background: white;
    border-radius: 1rem;
    padding: 1.5rem;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  }

  .card-heading {
    font-size: 1.125rem;
    font-weight: 700;
    color: #1f2937;
    margin-bottom: 1rem;
  }

  .checklist {
    list-style: none;
    padding: 0;
  }

  .checklist li {
    color: #4b5563;
    padding: 0.5rem 0;
    border-bottom: 1px solid #f3f4f6;
    font-size: 0.95rem;
  }

  .checklist li:last-child {
    border-bottom: none;
  }

  /* Next steps */
  .next-steps-card {
    margin-top: 0;
  }

  .next-steps-list {
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .step-item {
    display: flex;
    gap: 1rem;
    align-items: flex-start;
  }

  .step-number {
    width: 2rem;
    height: 2rem;
    background: #7c3aed;
    color: white;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    font-weight: 700;
    font-size: 0.875rem;
    flex-shrink: 0;
  }

  .step-item strong {
    color: #1f2937;
    display: block;
    margin-bottom: 0.25rem;
  }

  .step-item p {
    color: #6b7280;
    font-size: 0.9rem;
    margin: 0;
  }

  /* CTA */
  .text-center {
    text-align: center;
  }

  .cta-text {
    font-size: 1.125rem;
    opacity: 0.9;
    margin-bottom: 1.5rem;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
  }

  /* Buttons */
  .btn-primary {
    background: #7c3aed;
    color: white;
    border: none;
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: background 0.2s;
  }

  .btn-primary:hover {
    background: #6d28d9;
  }

  .btn-primary.large {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  .btn-secondary {
    background: transparent;
    color: white;
    border: 2px solid rgba(255, 255, 255, 0.4);
    padding: 0.75rem 1.5rem;
    border-radius: 0.5rem;
    font-weight: 600;
    cursor: pointer;
    text-decoration: none;
    display: inline-block;
    transition: border-color 0.2s, background 0.2s;
  }

  .btn-secondary:hover {
    border-color: white;
    background: rgba(255, 255, 255, 0.1);
  }

  .btn-secondary.large {
    padding: 1rem 2rem;
    font-size: 1.05rem;
  }

  /* Container */
  .container {
    max-width: 1200px;
    padding: 0 1.5rem;
  }

  .mx-auto {
    margin-left: auto;
    margin-right: auto;
  }

  /* Responsive */
  @media (max-width: 768px) {
    .event-title {
      font-size: 2rem;
    }

    .event-subtitle {
      font-size: 1.25rem;
    }

    .summary-grid {
      grid-template-columns: repeat(2, 1fr);
    }

    .highlights-grid {
      grid-template-columns: 1fr;
    }

    .two-col-grid {
      grid-template-columns: 1fr;
    }

    .event-meta {
      flex-direction: column;
      gap: 0.75rem;
    }

    .cta-buttons {
      flex-direction: column;
      align-items: center;
    }
  }
</style>
